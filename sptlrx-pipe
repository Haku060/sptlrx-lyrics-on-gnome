#!/usr/bin/env python3
"""
Pipe sptlrx lyrics output to a file for use with
GNOME Shell Executor extension or any status bar.

Single-threaded: no deadlocks, no GIL issues.

Usage: sptlrx-pipe [output_path]
  Default output path: /tmp/sptlrx-lyrics

Logs: /tmp/sptlrx-lyrics.log
"""

import json
import os
import select
import socket
import sys
import signal
import subprocess
import time
import urllib.request
import urllib.error
from datetime import datetime, timezone, timedelta

OUTPUT_PATH = sys.argv[1] if len(sys.argv) > 1 else "/tmp/sptlrx-lyrics"
LOG_PATH = os.path.splitext(OUTPUT_PATH)[0] + ".log"
AUTH_PATH = os.path.expanduser("~/.local/state/sptlrx/spotify-auth.json")

socket.setdefaulttimeout(5)

# State
is_playing = True
current_track_id = None
last_poll_ok = time.monotonic()
status_text = "♫"


def log(msg: str):
    now = datetime.now().strftime("%H:%M:%S")
    line = f"[{now}] {msg}"
    print(line, flush=True)
    try:
        with open(LOG_PATH, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def write_lyrics(text):
    if not text:
        with open(OUTPUT_PATH, "w") as f:
            f.write("")
        return
    try:
        tmp = OUTPUT_PATH + ".tmp"
        mode = "wb" if isinstance(text, bytes) else "w"
        with open(tmp, mode) as f:
            f.write(text)
        os.replace(tmp, OUTPUT_PATH)
    except OSError:
        pass


def load_auth():
    if not os.path.exists(AUTH_PATH):
        return None
    with open(AUTH_PATH) as f:
        return json.load(f)


def save_auth(data):
    os.makedirs(os.path.dirname(AUTH_PATH), exist_ok=True)
    with open(AUTH_PATH, "w") as f:
        json.dump(data, f)


def refresh_token_if_needed(auth):
    expires_at_str = auth.get("expires_at", "")
    if expires_at_str:
        try:
            dt = datetime.fromisoformat(expires_at_str)
            now = datetime.now(tz=dt.tzinfo or timezone.utc)
            if now < dt - timedelta(seconds=60):
                return auth.get("access_token"), auth
        except Exception:
            pass

    refresh_token = auth.get("refresh_token")
    client_id = auth.get("client_id")
    client_secret = auth.get("client_secret")
    if not refresh_token or not client_id or not client_secret:
        return None, auth

    data = urllib.parse.urlencode({
        "grant_type": "refresh_token",
        "refresh_token": refresh_token,
        "client_id": client_id,
        "client_secret": client_secret,
    }).encode()

    try:
        req = urllib.request.Request(
            "https://accounts.spotify.com/api/token",
            data=data,
            headers={"Content-Type": "application/x-www-form-urlencoded"},
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            result = json.loads(resp.read())
            auth["access_token"] = result["access_token"]
            if "refresh_token" in result:
                auth["refresh_token"] = result["refresh_token"]
            expires_dt = datetime.now(tz=timezone.utc) + timedelta(
                seconds=result.get("expires_in", 3600) - 60
            )
            auth["expires_at"] = expires_dt.astimezone().isoformat()
            save_auth(auth)
            log("Token refreshed OK")
            return auth["access_token"], auth
    except Exception as e:
        log(f"Token refresh FAILED: {e}")
        return auth.get("access_token"), auth


def do_spotify_poll():
    """Run one Spotify API poll. Called inline from main loop."""
    global is_playing, current_track_id, last_poll_ok, status_text

    try:
        auth = load_auth()
        if not auth:
            status_text = "⚠ Not logged in"
            write_lyrics(status_text)
            return

        token, auth = refresh_token_if_needed(auth)
        if not token:
            return

        req = urllib.request.Request(
            "https://api.spotify.com/v1/me/player",
            headers={"Authorization": f"Bearer {token}"},
        )
        try:
            with urllib.request.urlopen(req, timeout=5) as resp:
                last_poll_ok = time.monotonic()

                if resp.status == 204:
                    if is_playing:
                        is_playing = False
                        current_track_id = None
                        status_text = "⏹ Stopped"
                        write_lyrics(status_text)
                        log("Stopped (no device)")
                else:
                    data = json.loads(resp.read())
                    playing = data.get("is_playing", False)
                    new_track_id = (
                        data.get("item", {}).get("id")
                        if data.get("item") else None
                    )

                    if new_track_id and new_track_id != current_track_id:
                        current_track_id = new_track_id
                        write_lyrics(b"")
                        log("Track changed → cleared")

                    was_playing = is_playing
                    is_playing = playing

                    if was_playing and not playing:
                        status_text = "⏸ Paused"
                        write_lyrics(status_text)
                        log("Paused")
                    elif not was_playing and playing:
                        status_text = "♫"
                        log("Resumed")

        except urllib.error.HTTPError as e:
            if e.code == 401:
                log("Token rejected, will refresh")
                auth["expires_at"] = "1970-01-01T00:00:00+00:00"
                save_auth(auth)
            elif e.code == 404:
                if is_playing:
                    is_playing = False
                    current_track_id = None
                    status_text = "⏹ No active device"
                    write_lyrics(status_text)
                    log("Stopped (404)")

    except Exception as e:
        log(f"API error: {e}")
        age = time.monotonic() - last_poll_ok
        if age > 30:
            status_text = f"⚠ API unreachable ({int(age)}s)"
            write_lyrics(status_text)


def main():
    global is_playing, status_text

    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    try:
        with open(LOG_PATH, "w") as f:
            f.write(f"# sptlrx-pipe log — {datetime.now().isoformat()}\n")
    except OSError:
        pass

    write_lyrics(b"")
    log("sptlrx-pipe started (single-thread)")

    POLL_INTERVAL = 2   # poll Spotify every 2s
    PIPE_TIMEOUT = 20    # restart sptlrx if silent for 20s
    next_poll = 0

    while True:
        log("Starting sptlrx pipe...")
        proc = subprocess.Popen(
            ["sptlrx", "pipe"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        assert proc.stdout is not None

        while True:
            now = time.monotonic()
            wait = max(0.1, next_poll - now) if next_poll > now else POLL_INTERVAL
            ready, _, _ = select.select([proc.stdout], [], [], wait)
            now = time.monotonic()

            # Time to poll Spotify?
            if now >= next_poll:
                do_spotify_poll()
                next_poll = now + POLL_INTERVAL

            # Data from sptlrx?
            if ready:
                next_poll = now + POLL_INTERVAL  # reset poll timer on activity
                line = proc.stdout.readline()
                if not line:  # EOF
                    break
                text = line.strip()
                if text and is_playing:
                    write_lyrics(text)
            else:
                # No data — check if sptlrx has been silent too long
                if is_playing:
                    idle = PIPE_TIMEOUT
                else:
                    idle = 60  # when paused, be patient
                # We'd need to track last_output time... simpler: just restart if no output for a while
                # For now, the select timeout handles periodic checks

        proc.wait()
        log("sptlrx exited, restarting in 3s...")
        time.sleep(3)


if __name__ == "__main__":
    main()
