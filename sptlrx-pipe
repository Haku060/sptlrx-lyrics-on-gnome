def log(msg: str):
    now = datetime.now().strftime("%H:%M:%S")
    line = f"[{now}] {msg}"
    print(line, flush=True)
    try:
        with open(LOG_PATH, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def write_pidfile():
    try:
        with open(PID_PATH, "w") as f:
            f.write(str(os.getpid()))
    except OSError:
        pass


def remove_pidfile():
    try:
        if os.path.exists(PID_PATH):
            os.remove(PID_PATH)
    except OSError:
        pass


def another_instance_running():
    """Return True if the PID file points to a live sptlrx-pipe."""
    try:
        with open(PID_PATH) as f:
            pid = int(f.read().strip())
    except (OSError, ValueError):
        return False
    if pid == os.getpid():
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            cmdline = f.read().replace(b"\0", b" ").decode(
                "utf-8", "replace"
            )
        return "sptlrx-pipe" in cmdline
    except OSError:
        return True


def write_lyrics(text):
    """Atomically write text to the output file."""
    try:
        out_dir = os.path.dirname(OUTPUT_PATH)
        if out_dir:
            os.makedirs(out_dir, exist_ok=True)
        tmp = OUTPUT_PATH + ".tmp"
        with open(tmp, "w") as f:
            f.write(text or "")
        os.replace(tmp, OUTPUT_PATH)
    except OSError:
        pass


def set_output(text):
    """Write only when the content actually changes."""
    global last_written
    if text == last_written:
        return
    last_written = text
    write_lyrics(text)


def run_gdbus(args, timeout=3):
    """Run gdbus and return stdout, or None on failure."""
    try:
        result = subprocess.run(
            ["gdbus"] + args,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    return result.stdout


def list_mpris_players():
    """Return MPRIS bus names in the same order as go-mpris does."""
    out = run_gdbus(
        [
            "call",
            "--session",
            "--dest",
            "org.freedesktop.DBus",
            "--object-path",
            "/org/freedesktop/DBus",
            "--method",
            "org.freedesktop.DBus.ListNames",
        ]
    )
    if not out:
        return []
    names = re.findall(r"'([^']+)'", out)
    return [name for name in names if name.startswith(MPRIS_PREFIX)]


def read_mpris_whitelist(path):
    """Minimal reader for the `mpris.players` option in sptlrx's config."""
    try:
        with open(path) as f:
            lines = f.readlines()
    except OSError:
        return []

    in_mpris = False
    for i, raw in enumerate(lines):
        line = raw.rstrip("\n")
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))

        if indent == 0:
            in_mpris = stripped == "mpris:"
            continue
        if not in_mpris:
            continue
        if not stripped.startswith("players:"):
            continue

        value = stripped[len("players:"):].strip()
        if value.startswith("[") and value.endswith("]"):
            inner = value[1:-1].strip()
            if not inner:
                return []
            return [
                item.strip().strip("'\"")
                for item in inner.split(",")
                if item.strip()
            ]
        if value:
            return [value.strip("'\"").strip()]

        items = []
        for follow in lines[i + 1:]:
            f_stripped = follow.strip()
            if not f_stripped or f_stripped.startswith("#"):
                continue
            f_indent = len(follow) - len(follow.lstrip(" "))
            if f_indent < indent:
                break
            if f_stripped.startswith("- "):
                items.append(f_stripped[2:].strip().strip("'\""))
                continue
            break
        return items

    return []


def read_config_scalar(path, section, key):
    """Read a simple `section:\n  key: value` string from sptlrx's YAML."""
    try:
        with open(path) as f:
            lines = f.readlines()
    except OSError:
        return ""

    in_section = False
    for line in lines:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        indent = len(line) - len(line.lstrip(" "))
        if indent == 0:
            in_section = stripped == f"{section}:"
            continue
        if not in_section:
            continue
        if stripped.startswith(f"{key}:"):
            value = stripped[len(key) + 1:].strip()
            return value.strip("'\"")
    return ""


