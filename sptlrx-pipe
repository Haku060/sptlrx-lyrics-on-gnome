def aes_ecb_encrypt(data, key):
    try:
        from cryptography.hazmat.primitives.ciphers import (
            Cipher,
            algorithms,
            modes,
        )

        pad = 16 - len(data) % 16
        data = data + bytes([pad]) * pad
        encryptor = Cipher(algorithms.AES(key), modes.ECB()).encryptor()
        return encryptor.update(data) + encryptor.finalize()
    except ImportError:
        result = subprocess.run(
            [
                "openssl",
                "enc",
                "-aes-128-ecb",
                "-K",
                key.hex(),
                "-nosalt",
            ],
            input=data,
            capture_output=True,
            check=True,
        )
        return result.stdout


def netease_eapi_post(url, data):
    now_s = int(time.time())
    now_ms = int(time.time() * 1000)
    header = {
        "__csrf": "",
        "appver": "8.0.0",
        "buildver": str(now_s),
        "channel": "",
        "deviceId": "",
        "mobilename": "",
        "resolution": "1920x1080",
        "os": "android",
        "osver": "",
        "requestId": f"{now_ms}_{random.randint(0, 9999):04d}",
        "versioncode": "140",
        "MUSIC_U": "",
    }

    payload = dict(data)
    payload["header"] = json.dumps(header, separators=(",", ":"))
    path = url.replace("https://interface3.music.163.com/e", "/")
    path = path.replace("https://interface.music.163.com/e", "/")
    text = json.dumps(payload, separators=(",", ":"), ensure_ascii=False)
    digest = hashlib.md5(
        f"nobody{path}use{text}md5forencrypt".encode()
    ).hexdigest()
    raw = f"{path}-36cd479b6b5-{text}-36cd479b6b5-{digest}".encode()
    params = aes_ecb_encrypt(raw, NETEASE_EAPI_KEY).hex().upper()

    body = urllib.parse.urlencode({"params": params}).encode()
    headers = {
        "User-Agent": NETEASE_UA,
        "Referer": "https://music.163.com/",
        "Cookie": "; ".join(f"{k}={v}" for k, v in header.items()),
        "Content-Type": "application/x-www-form-urlencoded",
    }
    request = urllib.request.Request(
        url, data=body, headers=headers, method="POST"
    )
    with urllib.request.urlopen(request, timeout=12) as response:
        return json.loads(response.read().decode("utf-8"))


def netease_search(query):
    result = netease_eapi_post(
        NETEASE_SEARCH_URL,
        {
            "s": query,
            "type": "1",
            "limit": "20",
            "offset": "0",
            "total": "true",
        },
    )
    return ((result.get("result") or {}).get("songs") or [])


def netease_song_artists(song):
    artists = song.get("artists") or song.get("ar") or []
    return [a.get("name", "") for a in artists if a.get("name")]


def netease_song_duration(song):
    value = song.get("duration") or song.get("dt") or 0
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def netease_pick_song(songs, artist, title, length_ms):
    query_title = normalize(title)
    query_artist = normalize(artist)
    best = None
    best_score = 0

    for song in songs:
        song_title = normalize(song.get("name", ""))
        if not song_title:
            continue

        if song_title == query_title:
            title_score = 100
        elif query_title and (
            query_title in song_title or song_title in query_title
        ):
            title_score = 60
        else:
            title_score = 0

        artist_score = 0
        for name in netease_song_artists(song):
            name = normalize(name)
            if not name or not query_artist:
                continue
            if name == query_artist:
                artist_score = max(artist_score, 100)
            elif name in query_artist or query_artist in name:
                artist_score = max(artist_score, 60)

        duration_score = 0
        duration = netease_song_duration(song)
        if length_ms and duration:
            diff = abs(duration - length_ms)
            if diff <= 2000:
                duration_score = 60
            elif diff <= 5000:
                duration_score = 30
            elif diff <= 10000:
                duration_score = 10
            else:
                duration_score = -20

        # If the scripts differ, a very close duration plus a matching
        # artist is still a strong signal.
        if title_score == 0 and not (
            artist_score > 0 and duration_score >= 30
        ):
            continue

        score = title_score + artist_score + max(duration_score, 0)
        if score > best_score:
            best = song
            best_score = score

    return best, best_score


def netease_lyrics(song_id):
    result = netease_eapi_post(
        NETEASE_LYRIC_URL,
        {
            "id": str(song_id),
            "cp": "false",
            "lv": "0",
            "kv": "0",
            "tv": "0",
            "rv": "0",
            "yv": "0",
            "ytv": "0",
            "yrv": "0",
            "csrf_token": "",
        },
    )
    lrc = ((result.get("lrc") or {}).get("lyric") or "")
    yrc = ((result.get("yrc") or {}).get("lyric") or "")
    return lrc, yrc


def fetch_netease(artist, title, length_ms):
    query = f"{artist} {title}".strip()
    if not query:
        return []

    try:
        songs = netease_search(query)
        if not songs and artist:
            songs = netease_search(title)
        if not songs:
            log(f"NetEase: no search results for {query!r}")
            return []

        song, score = netease_pick_song(songs, artist, title, length_ms)
        if not song:
            log(f"NetEase: no suitable match for {query!r}")
            return []

        lrc, yrc = netease_lyrics(song["id"])
        lines = parse_lyrics(lrc)
        if len(lines) < 2:
            lines = parse_yrc(yrc)
        if len(lines) < 2:
            log(f"NetEase: no synced lyrics for {song.get('name')!r}")
            return []

        names = " / ".join(netease_song_artists(song))
        log(
            f"Lyrics source: NetEase ({song.get('name')} - {names}, "
            f"score={score})"
        )
        return lines
    except Exception as e:
        log(f"NetEase error: {type(e).__name__}: {e}")
        return []


# --- LRCLIB ---
def http_json(url, timeout=10):
    request = urllib.request.Request(
        url, headers={"User-Agent": LRCLIB_UA}
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def parse_lrclib_track(track):
    if not track:
        return []
    synced = track.get("syncedLyrics") or ""
    if synced:
        return parse_lrc(synced)
    return []


def fetch_lrclib(artist, title):
    if not title:
        return []
    try:
        params = urllib.parse.urlencode(
            {"artist_name": artist, "track_name": title}
        )
        try:
            data = http_json(f"https://lrclib.net/api/get?{params}")
            lines = parse_lrclib_track(data)
            if len(lines) >= 2:
                log("Lyrics source: LRCLIB")
                return lines
        except urllib.error.HTTPError as e:
            if e.code != 404:
                raise

        query = f"{artist} {title}".strip()
        results = http_json(
            "https://lrclib.net/api/search?"
            + urllib.parse.urlencode({"q": query})
        )
        for track in results or []:
            lines = parse_lrclib_track(track)
            if len(lines) >= 2:
                log("Lyrics source: LRCLIB (search)")
                return lines
    except Exception as e:
        log(f"LRCLIB error: {type(e).__name__}: {e}")
    return []


def fetch_lyrics(artist, title, length_ms, local_index):
    if not title:
        return []
    for source in LYRICS_SOURCES:
        if source == "local":
            lines = find_local_lyrics(artist, title, local_index)
        elif source == "netease":
            lines = fetch_netease(artist, title, length_ms)
        elif source == "lrclib":
            lines = fetch_lrclib(artist, title)
        else:
            continue
        if len(lines) >= 2:
            return lines
    return []


def find_line_index(times, position_ms):
    index = bisect.bisect_right(times, position_ms) - 1
    return index


def main():
    global is_playing, current_track_key, current_player

    if another_instance_running():
        print("sptlrx-pipe: another instance is already running", flush=True)
        return

    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    write_pidfile()
    atexit.register(remove_pidfile)

    try:
        with open(LOG_PATH, "w") as f:
            f.write(f"# sptlrx-pipe log - {datetime.now().isoformat()}\n")
    except OSError:
        pass

    write_lyrics("")
    log("sptlrx-pipe started (local MPRIS)")
    log(f"Lyrics sources: {', '.join(LYRICS_SOURCES)}")
    log(f"Lyrics offset: {LYRICS_OFFSET_MS:+d} ms")

    if not shutil.which("gdbus"):
        log("WARNING: gdbus not found; install glib2 (provides gdbus)")

    whitelist = read_mpris_whitelist(CONFIG_PATH)
    if whitelist:
        log(f"MPRIS whitelist: {', '.join(whitelist)}")
    else:
        log("MPRIS whitelist empty -> auto-detecting all players")

    local_folder = read_config_scalar(CONFIG_PATH, "local", "folder")
    local_index = build_local_index(local_folder)

    lines = []
    line_times = []
    line_index = -2
    position_base_ms = 0
    position_base_mono = time.monotonic()
    next_poll = 0.0
    known_buses = set()
    previous_playing = set()

    def current_position_ms():
        if not is_playing:
            return position_base_ms
        return position_base_ms + int(
            (time.monotonic() - position_base_mono) * 1000
        )

    def show_current_line():
        nonlocal line_index
        if not lines:
            return
        index = find_line_index(
            line_times, current_position_ms() + LYRICS_OFFSET_MS
        )
        if index == line_index:
            return
        line_index = index
        if index >= 0:
            set_output(lines[index][1])
        else:
            set_output("")

    while True:
        now = time.monotonic()

        if now >= next_poll:
            states = scan_players(whitelist)
            buses = set(bus for bus, _ in states)
            if buses != known_buses:
                known_buses = buses
                if states:
                    summary = ", ".join(
                        f"{player_suffix(bus)}={state.get('status')}"
                        for bus, state in states
                    )
                    log(f"Detected MPRIS players: {summary}")
                else:
                    log("Detected MPRIS players: none")

            playing_now = {
                bus
                for bus, state in states
                if state.get("status") == "Playing"
            }
            newly_playing = playing_now - previous_playing
            previous_playing = playing_now

            chosen = choose_player(states, current_player, newly_playing)
            by_bus = dict(states)

            if chosen != current_player:
                current_player = chosen
                current_track_key = None
                lines = []
                line_times = []
                line_index = -2
                if chosen:
                    selected = by_bus.get(chosen, {})
                    log(
                        f"Using MPRIS player: {chosen} "
                        f"({selected.get('status')}, "
                        f"{selected.get('label')})"
                    )
                else:
                    log("No MPRIS player found")

            if not chosen:
                is_playing = False
                line_index = -2
                set_output("\u23f9 No player")
            else:
                state = by_bus.get(chosen)
                if state is None:
                    state = {"status": None}

                status = state.get("status")
                if status is None:
                    is_playing = False
                    line_index = -2
                    set_output("")
                else:
                    was_playing = is_playing
                    track_key = state.get("track_key")

                    if track_key != current_track_key:
                        current_track_key = track_key
                        lines = []
                        line_times = []
                        line_index = -2
                        position_base_ms = state.get("position_ms") or 0
                        position_base_mono = time.monotonic()

                        if state.get("title"):
                            log(f"Track changed: {state.get('label')}")
                            if status == "Playing":
                                set_output("\u266b")
                            lines = fetch_lyrics(
                                state.get("artist", ""),
                                state.get("title", ""),
                                state.get("length_ms"),
                                local_index,
                            )
                            line_times = [item[0] for item in lines]
                            if lines:
                                index = find_line_index(
                                    line_times,
                                    position_base_ms + LYRICS_OFFSET_MS,
                                )
                                line_index = index
                                if index >= 0 and status == "Playing":
                                    set_output(lines[index][1])
                    else:
                        if state.get("position_ms") is not None:
                            position_base_ms = state["position_ms"]
                            position_base_mono = time.monotonic()

                    if status == "Playing":
                        if not was_playing:
                            log(f"Playing: {state.get('label')}")
                            if lines:
                                show_current_line()
                            else:
                                set_output("\u266b")
                        is_playing = True
                    else:
                        is_playing = False
                        line_index = -2
                        if status == "Paused":
                            set_output("\u23f8 Paused")
                        elif status == "Stopped":
                            set_output("\u23f9 Stopped")
                        else:
                            set_output("")

            next_poll = now + POLL_INTERVAL

        if is_playing and lines:
            show_current_line()

        time.sleep(TICK_INTERVAL)


if __name__ == "__main__":
    main()
