def player_suffix(bus_name):
    name = bus_name[len(MPRIS_PREFIX):] if bus_name.startswith(MPRIS_PREFIX) else bus_name
    return name.split(".instance", 1)[0]


def is_browser_player(bus_name):
    return player_suffix(bus_name).lower() in BROWSER_PLAYERS


def matches_whitelist(bus_name, whitelist):
    if not whitelist:
        return True
    for name in whitelist:
        full = MPRIS_PREFIX + name
        if bus_name == full or bus_name.startswith(full + ".instance"):
            return True
    return False


def scan_players(whitelist):
    """Return [(bus_name, state)] for all MPRIS players we can read."""
    states = []
    for bus_name in list_mpris_players():
        if not matches_whitelist(bus_name, whitelist):
            continue
        try:
            state = get_player_state(bus_name)
        except Exception as e:
            log(f"MPRIS error for {bus_name}: {type(e).__name__}: {e}")
            continue
        if state.get("status") is None:
            continue
        states.append((bus_name, state))
    return states


def choose_player(states, current_player, newly_playing=None):
    """
    Prefer the player that is actually Playing.

    Rules:
      - A music player that just started playing wins immediately, so
        pressing Play in NetEase/Spotify switches to that app.
      - Otherwise keep the current player if it is playing (a browser
        starting playback should not steal the lyrics).
      - If the current player is paused/stopped and another player is
        playing, switch to the playing one.
      - If nothing is playing, keep the current player if it still exists.
      - With no current player, fall back to the order reported by the
        session bus (music players still win over browsers, per rule 4).
    """
    if not states:
        return None

    newly_playing = newly_playing or set()
    by_bus = dict(states)
    current_state = by_bus.get(current_player)
    current_playing = bool(
        current_state and current_state.get("status") == "Playing"
    )

    playing = [
        (bus, state)
        for bus, state in states
        if state.get("status") == "Playing"
    ]

    order = {bus: index for index, (bus, _state) in enumerate(states)}

    def best(candidates):
        return min(
            candidates,
            key=lambda item: (
                is_browser_player(item[0]),
                order.get(item[0], len(states)),
            ),
        )[0]

    new_music = [
        item
        for item in playing
        if item[0] in newly_playing
        and not is_browser_player(item[0])
    ]
    if new_music:
        return best(new_music)

    if current_playing:
        if is_browser_player(current_player):
            music = [
                item for item in playing if not is_browser_player(item[0])
            ]
            if music:
                return best(music)
        return current_player

    if playing:
        return best(playing)

    if current_state is not None:
        return current_player

    return best(states)


# GVariant text output uses single quotes for strings, but switches to
# double quotes when the value itself contains a single quote.
GV_STRING = r"""(?:'((?:[^'\\]|\\.)*)'|"((?:[^"\\]|\\.)*)")"""


def gv_first_match(match):
    return match.group(1) if match.group(1) is not None else match.group(2)


def get_player_state(bus_name):
    """
    Return a dict with status, metadata, position and duration for a player.

    Position and mpris:length are converted from microseconds to milliseconds.
    """
    out = run_gdbus(
        [
            "call",
            "--session",
            "--dest",
            bus_name,
            "--object-path",
            MPRIS_OBJECT,
            "--method",
            "org.freedesktop.DBus.Properties.GetAll",
            MPRIS_PLAYER_IFACE,
        ]
    )
    empty = {
        "status": None,
        "track_key": None,
        "label": "",
        "title": "",
        "artist": "",
        "position_ms": None,
        "length_ms": None,
    }
    if not out:
        return empty

    status_match = re.search(r"'PlaybackStatus': <'([^']*)'>", out)
    status = status_match.group(1) if status_match else None

    title_match = re.search(r"'xesam:title': <" + GV_STRING + ">", out)
    artist_match = re.search(r"'xesam:artist': <\[(.*?)\]>", out, re.S)
    length_match = re.search(
        r"'mpris:length': <u?int64 (-?\d+)>", out
    )
    trackid_match = re.search(
        r"'mpris:trackid': <objectpath '([^']*)'>", out
    )
    position_match = re.search(r"'Position': <u?int64 (-?\d+)>", out)

    title = gv_first_match(title_match) if title_match else ""
    artist = ""
    if artist_match:
        artist = " ".join(
            gv_first_match(m)
            for m in re.finditer(GV_STRING, artist_match.group(1))
        )
    else:
        artist_match = re.search(
            r"'xesam:artist': <" + GV_STRING + ">", out
        )
        if artist_match:
            artist = gv_first_match(artist_match)

    length_us = int(length_match.group(1)) if length_match else 0
    trackid = trackid_match.group(1) if trackid_match else ""
    position_us = int(position_match.group(1)) if position_match else None

    key_parts = (artist, title, str(length_us), trackid)
    if any(key_parts):
        track_key = hashlib.md5(
            "\x1f".join(key_parts).encode("utf-8", "replace")
        ).hexdigest()
    else:
        track_key = None

    label = " - ".join(p for p in (artist, title) if p)
    return {
        "status": status,
        "track_key": track_key,
        "label": label,
        "title": title,
        "artist": artist,
        "position_ms": None if position_us is None else max(0, position_us // 1000),
        "length_ms": max(0, length_us // 1000) if length_us else None,
    }


# --- Chinese traditional -> simplified (helps match NetEase results) ---
_T2S = None


def load_t2s():
    global _T2S
    if _T2S is not None:
        return
    here = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        os.path.join(here, "data", "TSCharacters.txt"),
        os.path.join(here, "..", "share", "sptlrx", "TSCharacters.txt"),
        os.path.expanduser("~/.local/share/sptlrx/TSCharacters.txt"),
        "/usr/local/share/sptlrx/TSCharacters.txt",
        "/usr/share/sptlrx/TSCharacters.txt",
    ]
    data_dir = os.environ.get("SPTLRX_DATA_DIR")
    if data_dir:
        candidates.insert(0, os.path.join(data_dir, "TSCharacters.txt"))
    mapping = {}
    for path in candidates:
        if not os.path.isfile(path):
            continue
        try:
            with open(path, encoding="utf-8") as f:
                for line in f:
                    line = line.rstrip("\n")
                    if not line or line.startswith("#"):
                        continue
                    parts = line.split("\t")
                    if len(parts) >= 2 and parts[0]:
                        mapping[parts[0]] = parts[1].split()[0]
            break
        except OSError:
            continue
    _T2S = mapping


def to_simplified(text):
    load_t2s()
    if not _T2S:
        return text or ""
    return "".join(_T2S.get(ch, ch) for ch in text)


def normalize(text):
    text = to_simplified(text or "")
    text = unicodedata.normalize("NFKC", text).lower()
    text = re.sub(r"[\W_]+", " ", text, flags=re.UNICODE)
    return " ".join(text.split())


# --- LRC / YRC parsing ---
LRC_RE = re.compile(r"\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?\]")
YRC_RE = re.compile(r"^\[(\d+),(\d+)\](.*)$")


def parse_lrc(text):
    if not text:
        return []
    offset = 0
    offset_match = re.search(r"\[offset:\s*([+-]?\d+)\]", text)
    if offset_match:
        offset = int(offset_match.group(1))

    by_time = {}
    for raw in text.splitlines():
        stamps = list(LRC_RE.finditer(raw))
        if not stamps:
            continue
        words = raw[stamps[-1].end():].strip()
        for match in stamps:
            minutes = int(match.group(1))
            seconds = int(match.group(2))
            frac = match.group(3) or ""
            ms = minutes * 60000 + seconds * 1000
            if frac:
                ms += int(frac.ljust(3, "0")[:3])
            ms = max(0, ms + offset)
            by_time[ms] = words

    return sorted(by_time.items())


def parse_yrc(text):
    if not text:
        return []
    by_time = {}
    for raw in text.splitlines():
        match = YRC_RE.match(raw)
        if not match:
            continue
        ms = int(match.group(1))
        words = re.sub(r"\(\d+,\d+,\d+\)", "", match.group(3)).strip()
        by_time[ms] = words
    return sorted(by_time.items())


def parse_lyrics(text):
    lines = parse_lrc(text)
    if len(lines) >= 2:
        return lines
    yrc = parse_yrc(text)
    return yrc if len(yrc) > len(lines) else lines


# --- Local .lrc index ---
def build_local_index(folder):
    folder = (folder or "").strip()
    if not folder:
        return []
    folder = os.path.expanduser(folder)
    if not os.path.isdir(folder):
        log(f"Local lyrics folder not found: {folder}")
        return []

    index = []
    for root, _dirs, files in os.walk(folder):
        for name in files:
            if not name.lower().endswith(".lrc"):
                continue
            stem = os.path.splitext(name)[0]
            parts = set(normalize(stem).split())
            if parts:
                index.append((os.path.join(root, name), parts))
    log(f"Indexed {len(index)} local .lrc files from {folder}")
    return index


def find_local_lyrics(artist, title, index):
    if not index:
        return []
    query = set(normalize(f"{artist} {title}").split())
    if not query:
        return []

    best_path = None
    best_score = 0
    for path, parts in index:
        score = len(query & parts)
        if score > best_score:
            best_score = score
            best_path = path
    if not best_path or best_score == 0:
        return []

    try:
        with open(best_path, encoding="utf-8", errors="replace") as f:
            lines = parse_lyrics(f.read())
    except OSError:
        return []
    if len(lines) >= 2:
        log(f"Lyrics source: local ({best_path})")
        return lines
    return []


